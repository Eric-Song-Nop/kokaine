// monadic lift
fun @mlift-capture-error@10002[1,0,1,0] : forall<a,(e :: E)> (@y-x10000 : a) -> <(std/core/types/handled :: ((E, V) -> V) -> X)<(std/core/exn/exn :: (E, V) -> V)>|(e :: E)> (std/core/types/result :: (V, V) -> V)<a,std/core/exn/exception>;
pub fun capture-error[14,9,14,21] : forall<a,(e :: E)> (action : () -> <(std/core/types/handled :: ((E, V) -> V) -> X)<(std/core/exn/exn :: (E, V) -> V)>|(e :: E)> a) -> (e :: E) (std/core/exn/error :: V -> V)<a>;
 
fun @kokaine-cache-phase[1,0,1,0] : () -> std/core/types/int;
 
