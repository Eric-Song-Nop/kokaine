// One ref records which dynamic context a non-local exit must unwind. Keeping
// this separate from lifetime state matters when publication disposes itself.
value{1,0,1} type resume-phase[16,1,20,17] {
  con Resume-build[17,3,17,14]{0,0,0} : resume-phase = 1;
  con Resume-ambient[18,3,18,16]{0,0,0} : resume-phase = 2;
  con Resume-publication[19,3,19,20]{0,0,0} : resume-phase = 3;
  con Resume-complete[20,3,20,17]{0,0,0} : resume-phase = 4;
};
 
