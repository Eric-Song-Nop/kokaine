{
  "name": "@kokaine/monorepo",
  "private": true,
  "description": "Workspace root for Kokaine; the runtime is packages/core (@kokaine/core).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test:cli": "pnpm --filter @kokaine/cli --filter @kokaine/create test",
    "test:sidecar": "node --check packages/core/src/kokaine/dom-inline.js && node --check packages/core/src/kokaine/async/web-inline.js && node --check packages/core/src/kokaine/web/window-inline.js && node --test \"test/sidecar/*.test.mjs\"",
    "test": "pnpm run test:cli && pnpm run test:sidecar"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.20.0"
}
