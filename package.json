{
  "name": "@kokaine/core",
  "version": "0.1.1",
  "description": "A fine-grained UI runtime for Koka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eric-Song-Nop/kokaine.git"
  },
  "homepage": "https://github.com/Eric-Song-Nop/kokaine#readme",
  "bugs": {
    "url": "https://github.com/Eric-Song-Nop/kokaine/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "koka": {
    "schemaVersion": 1,
    "sources": [
      "src"
    ],
    "compiler": ">=3.2.3 <3.2.8",
    "targets": [
      "jsweb"
    ]
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:cli": "pnpm --filter @kokaine/cli --filter @kokaine/create test",
    "test:sidecar": "node --check src/kokaine/dom-inline.js && node --check src/kokaine/async/web-inline.js && node --check src/kokaine/web/window-inline.js && node --test \"test/sidecar/*.test.mjs\"",
    "test": "pnpm run test:cli && pnpm run test:sidecar"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.20.0"
}